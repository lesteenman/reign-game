#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"

# Ensure Go binaries are in PATH
export PATH="$PATH:$(go env GOPATH)/bin"

echo "=== Pre-push checks ==="

# Backend
echo "--- Backend: lint ---"
cd "$ROOT/backend"
if ! command -v golangci-lint &>/dev/null; then
  echo "ERROR: golangci-lint not found on PATH."
  echo "       CI uses v2.11.4 (pinned in .github/workflows/ci.yml)."
  echo "       Install: go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.11.4"
  echo "       Failing loud here so a missing local tool doesn't ship lint-broken commits to CI."
  exit 1
fi
golangci-lint run

echo "--- Backend: test ---"
go test -race -short ./... -count=1

# Infrastructure
echo "--- Terraform: fmt check ---"
cd "$ROOT/infra"
if ! command -v terraform &>/dev/null; then
  echo "ERROR: terraform not found on PATH."
  echo "       Install: https://developer.hashicorp.com/terraform/install"
  echo "       Failing loud here so an unformatted Terraform diff doesn't ship to CI."
  exit 1
fi
if ! terraform fmt -recursive -check -diff; then
  echo "ERROR: Terraform files not formatted. Run: terraform -chdir=infra fmt -recursive"
  exit 1
fi

# Frontend
echo "--- Frontend: lint ---"
cd "$ROOT/frontend"
npm run lint

echo "--- Frontend: build (tsc -b typechecks the app; @reign/core is typechecked by its own step) ---"
npm run build

echo "--- Frontend: unit tests ---"
npx vitest run

echo "--- Core: typecheck ---"
cd "$ROOT/packages/core"
npm run typecheck

echo "--- Core: unit tests ---"
cd "$ROOT/packages/core"
npx vitest run

echo "--- Workspace: npm audit ---"
cd "$ROOT"
npm audit --audit-level=moderate

# Secrets
echo "--- Secret scan ---"
cd "$ROOT"
if ! command -v gitleaks &>/dev/null; then
  echo "ERROR: gitleaks not found on PATH."
  echo "       Install (macOS): brew install gitleaks"
  echo "       Install (other):  https://github.com/gitleaks/gitleaks#installing"
  echo "       Failing loud here — secrets must not ship to CI / origin without a local scan."
  exit 1
fi
gitleaks detect --source .

echo "=== All pre-push checks passed ==="

# Copy to backend/.env.local (gitignored) and fill in. Dev values only.
#
# Clerk development instance keys come in pk_test_… / sk_test_… pairs.
# See docs/runbooks/admin-auth-setup.md (landed with R-089) for where
# to find them in the Clerk dashboard.
#
# CLERK_PUBLISHABLE_KEY is read by the frontend only — see
# frontend/.env.local.example (R-08B).

CLERK_SECRET_KEY=sk_test_REPLACE_ME

# CLERK_SECRET_PARAM_NAME stays unset in dev.
#
# In production (AWS Lambda) this variable holds the SSM Parameter
# Store path that stores the real secret as a SecureString. The
# secret itself never lives in a Lambda env var — env vars are
# readable via lambda:GetFunctionConfiguration.
#
# When CLERK_SECRET_KEY is empty, the backend falls back to fetching
# the parameter named by CLERK_SECRET_PARAM_NAME from SSM.
# CLERK_SECRET_PARAM_NAME=/reign/prod/clerk-secret-key

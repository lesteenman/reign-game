    "js-cookie": "3.0.7"
  },
  "devDependencies": {
    "@clerk/testing": "^2.0.35",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@tamagui/vite-plugin": "2.1.0",

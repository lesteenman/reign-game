# ===== Claude Code =====
# Local settings (secrets, personal env vars)
.claude/settings.local.json
# Editor undo/swap files in .claude
.claude/.*.un~
.claude/*.swp
.claude/*.swo
# Agent worktrees (created by Agent isolation: worktree)
.claude/worktrees/

# ===== Dev container =====
# Project-scoped secrets loaded via compose env_file.
# Tracked template lives at .devcontainer/.env.local.example.
.devcontainer/.env.local

# ===== Go (backend) =====
# Compiled binaries
backend/bin/
backend/cmd/*/main
backend/api
# Lambda build outputs (cmd/api → lambda.zip, cmd/daily-cron → daily-cron.zip).
# task build:lambda writes everything under backend/build/.
backend/build/
# Ad-hoc dev binaries from `go build ./cmd/X` at backend/ root.
backend/bootstrap
backend/daily-cron
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, coverage
*.test
*.out
backend/coverage.out
backend/coverage.html

# Go workspace
go.work
go.work.sum

# Dependency cache (local)
vendor/

# ===== Node / React (frontend) =====
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.vite/

# TypeScript build cache
*.tsbuildinfo

# Vitest
frontend/coverage/

# Playwright
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/playwright/.cache/

# ===== Terraform (infra) =====
# Local .terraform directories
**/.terraform/

# .tfstate files — state is stored remotely in S3
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Variable override files (may contain secrets)
*.tfvars
!infra/environments/**/*.tfvars

# Plan output files
*.tfplan

# Terraform lock file — commit this (consistency across machines)
# !.terraform.lock.hcl

# ===== IDE / Editor =====
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ===== Environment / Secrets =====
.env
.env.*
!.env.example
!.env.local.example

# ===== Logs =====
*.log
logs/

# ===== OS =====
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
.claude/scheduled_tasks.lock

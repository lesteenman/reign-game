# Project-scoped dev container secrets. Copy to `.env.local` (gitignored)
# and fill in. Loaded by the dev compose service via env_file — never
# passes through the host shell or your zshrc.
#
#   cp .devcontainer/.env.local.example .devcontainer/.env.local
#   chmod 600 .devcontainer/.env.local
#   ~/.devcontainers/bin/devcontainer up --workspace-folder . --remove-existing-container

# GitHub MCP server. Fine-grained PAT scoped to lesteenman/reign-game with:
#   contents r/w, pull_requests r/w, issues r/w, actions r, metadata r
# Create at https://github.com/settings/personal-access-tokens
GITHUB_PERSONAL_ACCESS_TOKEN=

# AWS MCP server. Must match a profile defined in your host's
# ~/.aws/config (bind-mounted read-only into the container). Run
# `aws sso login --profile <name>` on the host first to populate the
# bearer-token cache.
#
# Intentionally NOT named AWS_PROFILE: that would set AWS_PROFILE
# container-wide, which leaks into `go test` / backend code that doesn't
# expect a profile lookup. The .devcontainer/aws-mcp.sh wrapper translates
# this into AWS_PROFILE only for the MCP process. For ad-hoc `aws` CLI use
# inside the container, pass `--profile <name>` per command, or `export
# AWS_PROFILE=<name>` in your interactive shell session.
REIGN_AWS_PROFILE=
